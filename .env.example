# Firebase Admin / Google ADC
# Preferred in cloud: workload identity / application default credentials.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
# Firebase Web API key used only for email/password sign-in via Identity Toolkit.
# This is a Firebase Web API key, not the Admin service-account private key.
RADIOTECH_FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=your-company-project
FIRESTORE_BACKUP_BUCKET=
FIREBASE_STORAGE_BUCKET=
FIREBASE_RESTORE_BUCKET=
FIREBASE_RESTORE_PROJECT_ID=demo-radiotech-restore

RADIOTECH_CAPO_EMAIL=admin@example.com
RADIOTECH_CORS_ORIGINS=http://localhost:8080
RADIOTECH_RATE_LIMIT_PER_MINUTE=10
RADIOTECH_REPORT_VERIFICATION_SECRET=
RADIOTECH_PUBLIC_BASE_URL=https://reports.example.invalid
RADIOTECH_GEOFENCE_RADIUS_METERS=250
RADIOTECH_GPS_MAX_ACCURACY_METERS=100
RADIOTECH_SLA_WARNING_MINUTES=60
RADIOTECH_FIRESTORE_SEED=false
RADIOTECH_FIRESTORE_SEED_TENANT_ID=demo-tenant
RADIOTECH_BOOTSTRAP_SECRET=
RADIOTECH_BOOTSTRAP_TENANT_ID=demo-tenant
RADIOTECH_TENANT_INVITE_SECRET=
RADIOTECH_LEGACY_TENANT_ID=demo-tenant

# Buyer branding
RADIOTECH_BRAND_NAME=RadioTech
RADIOTECH_BRAND_SUBTITLE=Gestione operativa
RADIOTECH_BRAND_LOGO_PATH=/assets/brand/radiotech-symbol-v1.png
RADIOTECH_BRAND_COPYRIGHT=© 2026 RadioTech. Tutti i diritti riservati.
RADIOTECH_BRAND_SUPPORT_EMAIL=support@example.com
