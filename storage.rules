rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function activeDevice() {
      let device = firestore.get(/databases/(default)/documents/pro_devices/$(request.auth.token.radioDeviceId)).data;
      return device.uid == request.auth.uid && device.tenantId == request.auth.token.tenantId
        && device.status == 'ACTIVE';
    }
    function deviceSessionAllowed() {
      return signedIn() && (!('radioDeviceId' in request.auth.token)
        || (request.auth.token.radioDeviceId is string
          && request.auth.token.radioDeviceId.matches('^[a-f0-9]{64}$')
          && activeDevice()));
    }
    function hasTenant() {
      return deviceSessionAllowed()
        && request.auth.token.tenantId is string
        && request.auth.token.tenantId.size() > 0;
    }
    function role() { return signedIn() && request.auth.token.role != null ? request.auth.token.role : ''; }
    // Privileged access goes through the API and its independent authorization check.
    function manager() { return false; }
    function operator() { return signedIn() && role() in ['OPERATOR', 'OPERATORE']; }

    match /tenants/{tenantId}/maintenance-reports/{operatorId}/{allPaths=**} {
      allow read: if hasTenant()
        && request.auth.token.tenantId == tenantId
        && (manager() || (operator() && request.auth.uid == operatorId));
      allow write: if hasTenant()
        && request.auth.token.tenantId == tenantId
        && (manager() || (operator() && request.auth.uid == operatorId))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf)');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
