{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8180
    },
    "storage": {
      "port": 9198
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "radiotech-projections",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*-debug.log",
        "test"
      ]
    }
  ]
}
