{
  "name": "radiotech-identity-authority",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:web": "playwright test",
    "build": "esbuild web/access.js --bundle --minify --format=esm --outfile=public/access.js",
    "admin": "node src/admin.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.2.0",
    "nodemailer": "10.1.0"
  },
  "devDependencies": { "esbuild": "0.28.2", "@playwright/test": "1.63.0" },
  "overrides": { "@grpc/grpc-js": "^1.13.6" }
}
