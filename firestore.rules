rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeDevice() {
      let device = get(/databases/$(database)/documents/pro_devices/$(request.auth.token.radioDeviceId)).data;
      return device.uid == request.auth.uid && device.tenantId == request.auth.token.tenantId
        && device.status == 'ACTIVE';
    }
    function deviceSessionAllowed() {
      return signedIn() && (!('radioDeviceId' in request.auth.token)
        || (request.auth.token.radioDeviceId is string
          && request.auth.token.radioDeviceId.matches('^[a-f0-9]{64}$')
          && activeDevice()));
    }
    function hasTenant() {
      return deviceSessionAllowed()
        && request.auth.token.tenantId is string
        && request.auth.token.tenantId.size() > 0;
    }
    function tenantMatches(data) {
      return hasTenant() && data.tenantId == request.auth.token.tenantId;
    }
    function role() { return signedIn() && request.auth.token.role != null ? request.auth.token.role : ''; }
    // Privileged sessions must pass the API's independent membership and MFA checks.
    // This database cannot consult the authorization registry in the separate project.
    function manager() { return false; }
    function viewer() { return signedIn() && role() == 'VIEWER'; }
    function operator() { return signedIn() && role() in ['OPERATOR', 'OPERATORE']; }

    match /operators/{id} {
      allow read: if tenantMatches(resource.data)
        && (manager()
          || (operator() && (resource.data.firebaseUid == request.auth.uid || id == request.auth.uid)));
      allow create, update, delete: if false;
    }
    match /tasks/{id} {
      allow read: if tenantMatches(resource.data)
        && (manager() || viewer()
          || (operator() && (resource.data.operatorFirebaseUid == request.auth.uid || resource.data.operatorId == request.auth.uid)));
      allow create, update, delete: if false;
    }
    match /maintenanceReports/{id} {
      allow read: if tenantMatches(resource.data)
        && (manager() || viewer()
          || (operator() && (resource.data.operatorId == request.auth.uid || resource.data.operatorFirebaseUid == request.auth.uid)));
      allow create, update, delete: if false;
    }
    match /antennas/{id} {
      allow read: if tenantMatches(resource.data) && (manager() || viewer() || operator());
      allow create, update, delete: if false;
    }
    match /inventory/{id} {
      allow read: if tenantMatches(resource.data) && (manager() || viewer() || operator());
      allow create, update, delete: if false;
    }
    match /alerts/{id} {
      allow read: if tenantMatches(resource.data) && (manager() || viewer());
      allow create, update, delete: if false;
    }
    match /notificationHistory/{id} {
      allow read: if tenantMatches(resource.data)
        && (manager() || viewer()
          || (operator() && (resource.data.target == 'BROADCAST'
            || resource.data.target == request.auth.token.operatorId)));
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if (manager() || viewer()) && tenantMatches(resource.data);
      allow write: if false;
    }
    match /capo/{id} {
      allow read, write: if false;
    }
    match /users/{id} {
      allow read: if (manager() || viewer()) && tenantMatches(resource.data);
      allow create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
